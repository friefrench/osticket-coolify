# Copie en .env (local) ou saisis ces valeurs dans Coolify > Environment Variables.
# Obligatoires :
OSTICKET_EMAIL=support@exemple.com
ADMIN_EMAIL=admin@exemple.com
ADMIN_PASSWORD=change-moi-8car-min
DB_PASSWORD=change-moi
DB_ROOT_PASSWORD=change-moi-aussi
# Optionnelles (defauts dans docker-compose.yaml) :
OSTICKET_NAME=Support
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=Support
ADMIN_USERNAME=ostadmin
DB_NAME=osticket
DB_USER=osticket
TABLE_PREFIX=ost_
OSTICKET_TIMEZONE=Europe/Paris
OSTICKET_LANG=en_US
